datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Client {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  passwordHash    String?  // bcrypt hash for web panel authentication
  sshPasswordHash String?  // SHA-512 crypt hash for Linux/OpenSSH authentication
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // RSYNC Configurations
  rsyncEnabled    Boolean  @default(false)
  rsyncMode       String   @default("push") // push, pull, both
  rsyncProtocol   String   @default("rsync") // rsync, scp
  rsyncCron       String?  // cron expression
  rsyncHost       String?
  rsyncSshPort    String?  // SSH port (default: 22)
  rsyncUser       String?
  rsyncPath       String?
  rsyncSshKey     String?
  rsyncSshPassword String? // SSH password for rsync (alternative to RSA key)

  files           File[]
}

model File {
  id            String   @id @default(uuid())
  name          String
  path          String   // Storage location on the server
  size          Int      // Size in bytes
  mimeType      String   // Content-Type (e.g. application/pdf)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
