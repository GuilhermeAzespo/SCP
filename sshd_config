# SCP Server OpenSSH Configuration

# Listen on default port
Port 22

# Disable root login for security
PermitRootLogin no

# Allow password authentication (used by IP phones)
PasswordAuthentication yes

# Disable empty passwords
PermitEmptyPasswords no

# Use shadow file directly instead of PAM (more reliable on Alpine)
UsePAM no

# Disable StrictModes to prevent Docker volume permission issues from blocking login
StrictModes no

# Logging level
LogLevel DEBUG3

# SFTP subsystem
Subsystem sftp internal-sftp

# Restrict client group to SCP/SFTP via internal-sftp (no shell needed in chroot)
# ForceCommand internal-sftp is critical: it uses the built-in sshd sftp server,
# so no binaries or libs need to be copied inside the ChrootDirectory.
Match Group client
    ChrootDirectory /app/data/uploads/%u
    ForceCommand internal-sftp
    X11Forwarding no
    AllowTcpForwarding no