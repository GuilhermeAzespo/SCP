# SCP Server OpenSSH Configuration

# Listen on default port
Port 22

# Disable root login for security
PermitRootLogin no

# Allow password authentication (used by IP phones)
PasswordAuthentication yes

# Disable empty passwords
PermitEmptyPasswords no

# Use shadow file directly instead of PAM (more reliable on Alpine)
UsePAM no

# Disable StrictModes to prevent Docker volume permission issues from blocking login
StrictModes no

# Increase logging to DEBUG3 to see exactly why it rejects the password
LogLevel DEBUG3

# SFTP subsystem
Subsystem sftp internal-sftp

# Optional: You can enforce stricter restrictions globally, but since 
# clients have /bin/sh but no write access outside their homes, it's fairly safe.
